{{- /* Cloudflare Pages _redirects: a 301 for every old address in a page's `aliases` (Jekyll's redirect_from).
Hugo drops the trailing slash from aliases, so a folder-like address gets both forms. The redirect pages Hugo writes
for the same aliases stay, so the old addresses also work on any other host. */ -}}
# Generated by Hugo from the pages' aliases. Do not edit: change redirect_from in the page instead.
{{- $vistos := dict }}
{{- range site.Pages }}
{{- $destino := .RelPermalink }}
{{- range .Aliases }}
{{- $formas := slice . }}
{{- if not (path.Ext .) }}{{ $formas = slice (strings.TrimSuffix "/" .) (printf "%s/" (strings.TrimSuffix "/" .)) }}{{ end }}
{{- /* Browsers send accented letters percent-encoded: add that form too. */}}
{{- range $formas }}{{ if findRE `[^\x00-\x7F]` . }}{{ $formas = $formas | append (replace (urlquery .) "%2F" "/") }}{{ end }}{{ end }}
{{- range $formas }}
{{- if and (not (index $vistos .)) (ne . $destino) }}{{ $vistos = merge $vistos (dict . true) }}
{{ . }} {{ $destino }} 301
{{- end }}
{{- end }}
{{- end }}
{{- end }}
